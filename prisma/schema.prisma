// Canonical PostgreSQL invariants live in migration SQL, including unsupported
// CHECKs/deferred triggers. See docs/viewing-workflow-rollout.md; do not db push.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  APPLICANT @map("applicant")
  PROVIDER  @map("provider")
  ADMIN     @map("admin")
}

enum UserStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  DELETED   @map("deleted")
}

enum ListingStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  PAUSED    @map("paused")
  ARCHIVED  @map("archived")
  RENTED    @map("rented")
}

enum ObjectType {
  APARTMENT @map("apartment")
  HOUSE     @map("house")
  ROOM      @map("room")
}

enum PetsPolicy {
  ALLOWED        @map("allowed")
  BY_ARRANGEMENT @map("by_arrangement")
  NOT_ALLOWED    @map("not_allowed")
}

enum SmokingPolicy {
  ALLOWED        @map("allowed")
  BY_ARRANGEMENT @map("by_arrangement")
  NOT_ALLOWED    @map("not_allowed")
}

enum ApplicationStatus {
  ACTIVE        @map("active")
  WAITING       @map("waiting")
  REJECTED      @map("rejected")
  WITHDRAWN     @map("withdrawn")
  ACCEPTED      @map("accepted")
}

enum ApplicationRejectionReason {
  POST_VIEWING_RESPONSE_EXPIRED @map("post_viewing_response_expired")
  NOT_SELECTED                @map("not_selected")
  LISTING_RENTED              @map("listing_rented")
  PROFILE_NO_LONGER_ELIGIBLE  @map("profile_no_longer_eligible")
}

enum ListingEventType {
  REJECTED_BY_PROVIDER  @map("rejected_by_provider")
  RESTORED_BY_PROVIDER  @map("restored_by_provider")
}

enum ListingEventSource {
  SYSTEM    @map("system")
  PROVIDER  @map("provider")
  APPLICANT @map("applicant")
}

enum ApplicationActivityType {
  VIEWING_WORKFLOW_CLOSED @map("viewing_workflow_closed")
  VIEWING_CONSIDERATION_CHANGED @map("viewing_consideration_changed")
  VIEWING_INTEREST_EXPIRED @map("viewing_interest_expired")
  VIEWING_REPLACEMENT_PROPOSED @map("viewing_replacement_proposed")
  VIEWING_PROPOSAL_WITHDRAWN @map("viewing_proposal_withdrawn")
  VIEWING_PROPOSAL_EXPIRED @map("viewing_proposal_expired")
  VIEWING_PROPOSED @map("viewing_proposed")
  VIEWING_ACCEPTED @map("viewing_accepted")
  VIEWING_DECLINED @map("viewing_declined")
  VIEWING_CHANGE_REQUESTED @map("viewing_change_requested")
  VIEWING_RESCHEDULED @map("viewing_rescheduled")
  VIEWING_CANCELLED @map("viewing_cancelled")
  VIEWING_COMPLETED @map("viewing_completed")
  VIEWING_NO_SHOW @map("viewing_no_show")
  VIEWING_OUTCOME_CORRECTED @map("viewing_outcome_corrected")
  VIEWING_INTEREST_CONFIRMED @map("viewing_interest_confirmed")
  VIEWING_INTEREST_DECLINED @map("viewing_interest_declined")
  APPLICATION_SUBMITTED          @map("application_submitted")
  APPLICATION_PROMOTED_TO_ACTIVE @map("application_promoted_to_active")
  APPLICATION_WITHDRAWN          @map("application_withdrawn")
  APPLICATION_REJECTED           @map("application_rejected")
  APPLICATION_RESTORED           @map("application_restored")
  APPLICATION_ACCEPTED           @map("application_accepted")
  CONVERSATION_OPENED            @map("conversation_opened")
  MESSAGE_SENT                   @map("message_sent")
  APPLICANT_REPLIES_ENABLED @map("applicant_replies_enabled")
  APPLICANT_REPLIES_DISABLED @map("applicant_replies_disabled")
  DOCUMENT_REQUESTED             @map("document_requested")
  DOCUMENT_REQUEST_CANCELLED       @map("document_request_cancelled")
  DOCUMENT_UPLOADED              @map("document_uploaded")
  DOCUMENT_REVIEWED              @map("document_reviewed")
}

enum ApplicationDocumentType {
  SCHUFA              @map("schufa")
  INCOME_PROOF        @map("income_proof")
  IDENTITY_DOCUMENT   @map("identity_document")
  LIABILITY_INSURANCE @map("liability_insurance")
  OTHER               @map("other")
}

enum ApplicationDocumentState {
  PROCESSING @map("processing")
  AVAILABLE  @map("available")
  FAILED     @map("failed")
}

enum ConversationSide {
  PROVIDER  @map("provider")
  APPLICANT @map("applicant")
}

enum ApplicationActivityActorType {
  SYSTEM    @map("system")
  APPLICANT @map("applicant")
  PROVIDER  @map("provider")
}

enum ApplicationActivityVisibility {
  PROVIDER  @map("provider")
  APPLICANT @map("applicant")
  BOTH      @map("both")
  INTERNAL  @map("internal")
}

enum ListingReportReason {
  MISLEADING_INFO       @map("misleading_info")
  SCAM_OR_FRAUD         @map("scam_or_fraud")
  DISCRIMINATION        @map("discrimination")
  INAPPROPRIATE_CONTENT @map("inappropriate_content")
  DUPLICATE_OR_SPAM     @map("duplicate_or_spam")
  OTHER                 @map("other")
}

enum ProviderType {
  PRIVATE @map("private")
  COMPANY @map("company")
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  name              String
  email             String        @unique
  passwordHash      String        @map("password_hash")
  role              Role          @default(APPLICANT)
  providerType      ProviderType? @map("provider_type")
  companyName       String?       @map("company_name")
  emailVerified     Boolean       @default(false) @map("email_verified")
  status            UserStatus    @default(ACTIVE)
  acceptedTermsAt   DateTime      @map("accepted_terms_at")
  acceptedPrivacyAt DateTime      @map("accepted_privacy_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  listings     Listing[]
  applications Application[]
  listingEvents ListingEvent[] @relation("ListingEventActor")
  applicationActivities ApplicationActivity[] @relation("ApplicationActivityActor")
  profile      ApplicantProfile?
  passwordResetTokens PasswordResetToken[]
  notifications Notification[]
  savedListings SavedListing[]
  listingReports ListingReport[] @relation("ListingReportReporter")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@map("password_reset_tokens")
}

model Listing {
  id         String        @id @default(uuid()) @db.Uuid
  providerId String        @map("provider_id") @db.Uuid
  status     ListingStatus @default(DRAFT)
  displayOrder Int          @map("display_order")

  city             String?
  zip              String?
  street           String?
  district         String?
  country          String  @default("DE")
  showExactAddress Boolean @default(false) @map("show_exact_address")

  objectType      ObjectType? @map("object_type")
  livingArea      Float?     @map("living_area")
  rooms           Float?
  bedrooms        Int?
  coldRent        Float?     @map("cold_rent")
  additionalCosts Float?     @map("additional_costs")
  deposit         Float?
  depositMonths   Int        @default(2) @map("deposit_months")
  availableFrom   DateTime?  @map("available_from")

  title            String?
  shortDescription String?  @map("short_description")
  photos           String[]

  minimumHouseholdNetIncome Float?         @map("minimum_household_net_income")
  schufaRequired            Boolean        @default(false) @map("schufa_required")
  incomeProofRequired       Boolean        @default(false) @map("income_proof_required")
  suitableForPeopleCount    Int?           @map("suitable_for_people_count")
  petsPolicy                PetsPolicy?    @map("pets_policy")
  smokingPolicy             SmokingPolicy? @map("smoking_policy")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")
  rentedAt    DateTime? @map("rented_at") @db.Timestamptz(6)

  provider User @relation(fields: [providerId], references: [id])

  considerationPositions ApplicationConsiderationPosition[]
  applications Application[]
  images       ListingImage[]
  listingEvents ListingEvent[]
  savedListings SavedListing[]
  listingReports ListingReport[]

  @@index([status, publishedAt, id])
  @@index([status, coldRent, id])
  @@index([status, livingArea, id])
  @@index([status, availableFrom])
  @@unique([providerId, displayOrder])
  @@index([providerId, displayOrder, id])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  publicId  String   @unique @map("public_id")
  secureUrl String   @map("secure_url")
  position  Int      @default(0)
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@index([listingId])
  @@map("listing_images")
}

model Application {
  id           String             @id @default(uuid()) @db.Uuid
  listingId    String             @map("listing_id") @db.Uuid
  applicantId  String             @map("applicant_id") @db.Uuid
  status       ApplicationStatus  @default(WAITING)
  queueOrder   BigInt             @unique @default(autoincrement()) @map("queue_order")
  rejectedAt   DateTime?                    @map("rejected_at") @db.Timestamptz(6)
  publicReason ApplicationRejectionReason? @map("public_reason")
  activeAt     DateTime?                    @map("active_at") @db.Timestamptz(6)
  withdrawnAt  DateTime?                    @map("withdrawn_at") @db.Timestamptz(6)
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  listing   Listing @relation(fields: [listingId], references: [id])
  applicant User    @relation(fields: [applicantId], references: [id])
  listingEvents ListingEvent[]
  activities ApplicationActivity[]
  conversation ApplicationConversation?
  documentRequests ApplicationDocumentRequest[]
  viewings ApplicationViewing[]
  viewingWorkflow ViewingWorkflow?
  viewingCommandReceipts ViewingCommandReceipt[]
  considerationPosition ApplicationConsiderationPosition?
  noShowConsequences ApplicationNoShowConsequence[]
  notifications Notification[]

  @@unique([id, listingId])
  @@index([listingId, status, queueOrder])
  @@index([applicantId])
  @@map("applications")
}

enum ApplicationViewingStatus {
  OUTCOME_PENDING @map("outcome_pending")
  PROPOSED @map("proposed")
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
  CHANGE_REQUESTED @map("change_requested")
  CANCELLED @map("cancelled")
  COMPLETED @map("completed")
  NO_SHOW @map("no_show")
  SUPERSEDED @map("superseded")
}

enum ViewingOutcome {
  COMPLETED @map("completed")
  NO_SHOW @map("no_show")
}

enum ViewingInterest {
  STILL_INTERESTED @map("still_interested")
  NOT_INTERESTED @map("not_interested")
}

model ApplicationViewing {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  round Int
  status ApplicationViewingStatus @default(PROPOSED)
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  timeZone String @map("time_zone") @db.VarChar(100)
  providerNote String? @map("provider_note") @db.VarChar(500)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  declinedAt DateTime? @map("declined_at") @db.Timestamptz(3)
  changeRequestedAt DateTime? @map("change_requested_at") @db.Timestamptz(3)
  changeRequestMessage String? @map("change_request_message") @db.VarChar(500)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(3)
  requestKey String @map("request_key") @db.Uuid
  requestHash String @map("request_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  outcomes ApplicationViewingOutcome[]
  interest ApplicationViewingInterest?
  appointment ViewingAppointment?
  @@unique([applicationId, round])
  @@unique([applicationId, requestKey])
  @@index([applicationId, status, round])
  @@map("application_viewings")
}

model ApplicationViewingOutcome {
  id String @id @default(uuid()) @db.Uuid
  viewingId String @map("viewing_id") @db.Uuid
  revision Int
  outcome ViewingOutcome
  absenceSide ViewingAbsenceSide? @map("absence_side")
  correctionReason String? @map("correction_reason") @db.VarChar(500)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  viewing ApplicationViewing @relation(fields: [viewingId], references: [id], onDelete: Restrict)
  noShowConsequence ApplicationNoShowConsequence? @relation("NoShowSource")
  correctedNoShowConsequence ApplicationNoShowConsequence? @relation("NoShowCorrection")
  @@unique([viewingId, revision])
  @@map("application_viewing_outcomes")
}

model ApplicationViewingInterest {
  id String @id @default(uuid()) @db.Uuid
  viewingId String @unique @map("viewing_id") @db.Uuid
  interest ViewingInterest
  respondedAt DateTime @default(now()) @map("responded_at") @db.Timestamptz(3)
  viewing ApplicationViewing @relation(fields: [viewingId], references: [id], onDelete: Restrict)
  @@map("application_viewing_interests")
}

// ApplicationViewing remains the appointment/history ledger. Legacy unaccepted
// rounds stay there for old IDs; new unaccepted schedules live only in proposals.
enum ViewingParticipantSide {
  PROVIDER @map("provider")
  APPLICANT @map("applicant")
}

enum ViewingWorkflowMode {
  LEGACY @map("legacy")
  CURRENT @map("current")
}

enum ViewingWorkflowState {
  OPEN @map("open")
  CLOSED @map("closed")
}

enum ViewingClosureReason {
  LISTING_UNPUBLISHED @map("listing_unpublished")
  PROVIDER_CLOSED @map("provider_closed")
  APPLICATION_WITHDRAWN @map("application_withdrawn")
  APPLICATION_REJECTED @map("application_rejected")
  APPLICATION_ACCEPTED @map("application_accepted")
  LISTING_RENTED @map("listing_rented")
  LISTING_ARCHIVED @map("listing_archived")
  ELIGIBILITY_REJECTED @map("eligibility_rejected")
  POST_VIEWING_RESPONSE_EXPIRED @map("post_viewing_response_expired")
}

enum ViewingProposalTiming {
  NORMAL @map("normal")
  SHORT_NOTICE @map("short_notice")
  LEGACY @map("legacy")
}

enum ViewingProposalResolution {
  PENDING @map("pending")
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
  SUPERSEDED @map("superseded")
  WITHDRAWN @map("withdrawn")
  EXPIRED @map("expired")
  CLOSED @map("closed")
}

enum ViewingCancellationReason {
  APPLICANT_CANCELLED @map("applicant_cancelled")
  PROVIDER_ILLNESS @map("provider_illness")
  PROVIDER_OPERATIONAL @map("provider_operational")
  PROPERTY_UNAVAILABLE @map("property_unavailable")
  OTHER @map("other")
  APPLICATION_ENDED @map("application_ended")
}

enum ViewingAbsenceSide {
  APPLICANT @map("applicant")
  PROVIDER @map("provider")
  BOTH @map("both")
}

enum ViewingInterestState {
  NOT_REQUESTED @map("not_requested")
  PENDING @map("pending")
  STILL_INTERESTED @map("still_interested")
  NOT_INTERESTED @map("not_interested")
  EXPIRED @map("expired")
  CLOSED @map("closed")
  LEGACY_UNANSWERED @map("legacy_unanswered")
}

enum ViewingProviderConsideration {
  UNDECIDED @map("undecided")
  CONTINUE_CONSIDERING @map("continue_considering")
  DO_NOT_CONTINUE @map("do_not_continue")
}

model ViewingWorkflow {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @unique @map("application_id") @db.Uuid
  // LEGACY backfill is a cutover snapshot, not an authoritative live projection.
  mode ViewingWorkflowMode @default(CURRENT)
  revision Int @default(0)
  initiatorSide ViewingParticipantSide @default(PROVIDER) @map("initiator_side")
  state ViewingWorkflowState @default(OPEN)
  closureReason ViewingClosureReason? @map("closure_reason")
  closedAt DateTime? @map("closed_at") @db.Timestamptz(3)
  pendingProposalId String? @unique @map("pending_proposal_id") @db.Uuid
  confirmedAppointmentId String? @unique @map("confirmed_appointment_id") @db.Uuid
  providerConsideration ViewingProviderConsideration @default(UNDECIDED) @map("provider_consideration")
  considerationDecidedAt DateTime? @map("consideration_decided_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  proposals ViewingProposal[] @relation("WorkflowProposals")
  appointments ViewingAppointment[] @relation("WorkflowAppointments")
  pendingProposal ViewingProposal? @relation("PendingProposal", fields: [pendingProposalId, id], references: [id, workflowId], onDelete: Restrict, map: "pending_proposal_same_workflow")
  confirmedAppointment ViewingAppointment? @relation("ConfirmedAppointment", fields: [confirmedAppointmentId, id], references: [viewingId, workflowId], onDelete: Restrict, map: "confirmed_appointment_same_workflow")
  @@unique([pendingProposalId, id])
  @@unique([confirmedAppointmentId, id])
  @@map("viewing_workflows")
}

model ViewingProposal {
  id String @id @default(uuid()) @db.Uuid
  workflowId String @map("workflow_id") @db.Uuid
  round Int
  proposerSide ViewingParticipantSide @map("proposer_side")
  responderSide ViewingParticipantSide @map("responder_side")
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  timeZone String @map("time_zone") @db.VarChar(100)
  message String? @db.VarChar(500)
  predecessorProposalId String? @map("predecessor_proposal_id") @db.Uuid
  baseAppointmentId String? @map("base_appointment_id") @db.Uuid
  timing ViewingProposalTiming
  responseDeadlineAt DateTime? @map("response_deadline_at") @db.Timestamptz(3)
  resolution ViewingProposalResolution @default(PENDING)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedBy ApplicationActivityActorType? @map("resolved_by")
  requestKey String @map("request_key") @db.Uuid
  requestHash String @map("request_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  workflow ViewingWorkflow @relation("WorkflowProposals", fields: [workflowId], references: [id], onDelete: Restrict)
  pendingFor ViewingWorkflow? @relation("PendingProposal")
  predecessor ViewingProposal? @relation("ProposalPredecessor", fields: [predecessorProposalId, workflowId], references: [id, workflowId], onDelete: Restrict, map: "predecessor_same_workflow")
  successors ViewingProposal[] @relation("ProposalPredecessor")
  baseAppointment ViewingAppointment? @relation("ProposalBase", fields: [baseAppointmentId, workflowId], references: [viewingId, workflowId], onDelete: Restrict, map: "base_appointment_same_workflow")
  appointment ViewingAppointment? @relation("AppointmentSource")
  @@unique([workflowId, round])
  @@unique([workflowId, requestKey])
  @@unique([id, workflowId])
  @@index([resolution, responseDeadlineAt])
  @@map("viewing_proposals")
}

model ViewingAppointment {
  // Same ID as its ApplicationViewing ledger row and all existing outcome/history links.
  viewingId String @id @map("viewing_id") @db.Uuid
  workflowId String @map("workflow_id") @db.Uuid
  proposalId String @unique @map("proposal_id") @db.Uuid
  cancelledBy ApplicationActivityActorType? @map("cancelled_by")
  cancellationReason ViewingCancellationReason? @map("cancellation_reason")
  cancellationNote String? @map("cancellation_note") @db.VarChar(500)
  lateCancellation Boolean? @map("late_cancellation")
  interestState ViewingInterestState @default(NOT_REQUESTED) @map("interest_state")
  interestRequestedAt DateTime? @map("interest_requested_at") @db.Timestamptz(3)
  interestDeadlineAt DateTime? @map("interest_deadline_at") @db.Timestamptz(3)
  interestClosedAt DateTime? @map("interest_closed_at") @db.Timestamptz(3)
  viewing ApplicationViewing @relation(fields: [viewingId], references: [id], onDelete: Restrict)
  workflow ViewingWorkflow @relation("WorkflowAppointments", fields: [workflowId], references: [id], onDelete: Restrict)
  sourceProposal ViewingProposal @relation("AppointmentSource", fields: [proposalId, workflowId], references: [id, workflowId], onDelete: Restrict, map: "source_proposal_same_workflow")
  confirmedFor ViewingWorkflow? @relation("ConfirmedAppointment")
  alternatives ViewingProposal[] @relation("ProposalBase")
  @@unique([viewingId, workflowId])
  @@unique([proposalId, workflowId])
  @@index([interestState, interestDeadlineAt])
  @@map("viewing_appointments")
}

// Separate from WAITING queueOrder and historical activeAt. No behavioral ranking.
model ApplicationConsiderationPosition {
  applicationId String @id @map("application_id") @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  position BigInt @default(autoincrement())
  revision Int @default(0)
  application Application @relation(fields: [applicationId, listingId], references: [id, listingId], onDelete: Restrict, map: "consideration_same_listing")
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  @@unique([listingId, position])
  @@unique([applicationId, listingId])
  @@map("application_consideration_positions")
}

model ApplicationNoShowConsequence {
  outcomeId String @id @map("outcome_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  previousPosition BigInt @map("previous_position")
  appliedPosition BigInt @map("applied_position")
  appliedRevision Int @map("applied_revision")
  correctedByOutcomeId String? @unique @map("corrected_by_outcome_id") @db.Uuid
  correctedAt DateTime? @map("corrected_at") @db.Timestamptz(3)
  positionRestored Boolean? @map("position_restored")
  application Application @relation(fields: [applicationId, listingId], references: [id, listingId], onDelete: Restrict, onUpdate: NoAction)
  sourceOutcome ApplicationViewingOutcome @relation("NoShowSource", fields: [outcomeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  correctionOutcome ApplicationViewingOutcome? @relation("NoShowCorrection", fields: [correctedByOutcomeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([applicationId])
  @@map("application_no_show_consequences")
}

model ListingEvent {
  id            String             @id @default(uuid()) @db.Uuid
  listingId     String             @map("listing_id") @db.Uuid
  applicationId String?            @map("application_id") @db.Uuid
  type          ListingEventType
  source        ListingEventSource
  actorUserId   String?            @map("actor_user_id") @db.Uuid
  reason        String?
  payload       Json?
  occurredAt    DateTime           @default(now()) @map("occurred_at")

  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  actor       User?       @relation("ListingEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([listingId, occurredAt])
  @@index([applicationId, occurredAt])
  @@map("listing_events")
}

model ApplicationActivity {
  id          String                         @id @default(uuid()) @db.Uuid
  applicationId String                       @map("application_id") @db.Uuid
  type        ApplicationActivityType
  actorUserId String?                        @map("actor_user_id") @db.Uuid
  actorType   ApplicationActivityActorType   @map("actor_type")
  visibility  ApplicationActivityVisibility
  occurredAt  DateTime                       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  payload     Json?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?        @relation("ApplicationActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@unique([id, applicationId])
  @@index([applicationId, occurredAt, id])
  @@index([applicationId, visibility, occurredAt, id], map: "application_activities_application_id_visibility_occurred_at_id")
  @@map("application_activities")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid
  recipientSide ViewingParticipantSide @map("recipient_side")
  applicationId String @map("application_id") @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  sourceActivityId String @map("source_activity_id") @db.Uuid
  type ApplicationActivityType
  workflowId String? @map("workflow_id") @db.Uuid
  proposalId String? @map("proposal_id") @db.Uuid
  appointmentId String? @map("appointment_id") @db.Uuid
  section String @db.VarChar(16)
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt DateTime? @map("read_at") @db.Timestamptz(3)
  expiresAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '90 days'::interval)")) @map("expires_at") @db.Timestamptz(3)
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_recipient_id_fkey")
  application Application @relation(fields: [applicationId, listingId], references: [id, listingId], onDelete: Cascade, onUpdate: NoAction, map: "notification_application")
  sourceActivity ApplicationActivity @relation(fields: [sourceActivityId, applicationId], references: [id, applicationId], onDelete: Cascade, onUpdate: NoAction, map: "notification_activity")
  @@unique([sourceActivityId, recipientId])
  @@index([recipientId, createdAt, id])
  @@index([recipientId, readAt])
  @@index([expiresAt])
  @@map("notifications")
}

model ApplicationConversation {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @unique @map("application_id") @db.Uuid
  openedAt      DateTime @default(now()) @map("opened_at")
  applicantRepliesEnabled Boolean @default(false) @map("applicant_replies_enabled")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages ApplicationMessage[]

  @@map("application_conversations")
}

model ApplicationMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  sequence       Int
  senderType     ConversationSide @map("sender_type")
  body           String           @db.VarChar(4000)
  createdAt      DateTime         @default(now()) @map("created_at")
  readAt         DateTime?        @map("read_at")

  conversation ApplicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([conversationId, senderType, readAt])
  @@map("application_messages")
}

model ApplicationDocumentRequest {
  id            String                    @id @default(uuid()) @db.Uuid
  applicationId String                    @map("application_id") @db.Uuid
  type          ApplicationDocumentType
  customLabel   String?                   @map("custom_label") @db.VarChar(100)
  logicalKey    String                    @map("logical_key") @db.VarChar(120)
  round         Int
  requestedAt   DateTime                  @default(now()) @map("requested_at")
  supersededAt  DateTime?                 @map("superseded_at")
  currentFileId String?                   @unique @map("current_file_id") @db.Uuid
  application   Application               @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  files         ApplicationDocumentFile[] @relation("DocumentAttempts")
  currentFile   ApplicationDocumentFile?  @relation("CurrentDocument", fields: [currentFileId], references: [id], onDelete: SetNull)

  @@unique([applicationId, logicalKey, round])
  @@index([applicationId, requestedAt, id])
  @@map("application_document_requests")
}

model ApplicationDocumentFile {
  id            String                      @id @default(uuid()) @db.Uuid
  requestId     String                      @map("request_id") @db.Uuid
  storageKey    String                      @unique @map("storage_key")
  bucket        String
  versionId     String?                     @map("version_id")
  etag          String?
  checksum      String
  mimeType      String                      @map("mime_type")
  size          Int
  state         ApplicationDocumentState    @default(PROCESSING)
  createdAt     DateTime                    @default(now()) @map("created_at")
  recoverAfter  DateTime                    @map("recover_after")
  expiresAt     DateTime                    @map("expires_at")
  availableAt   DateTime?                   @map("available_at")
  reviewedAt    DateTime?                   @map("reviewed_at")
  scanVerdict   String?                     @map("scan_verdict")
  failureReason String?                     @map("failure_reason")
  request       ApplicationDocumentRequest  @relation("DocumentAttempts", fields: [requestId], references: [id], onDelete: Restrict)
  currentFor    ApplicationDocumentRequest? @relation("CurrentDocument")

  @@index([state, recoverAfter, id])
  @@index([requestId, createdAt, id])
  @@map("application_document_files")
}

model ApplicantProfile {
  id                   String         @id @default(uuid()) @db.Uuid
  applicantId          String         @unique @map("applicant_id") @db.Uuid
  introduction         String?
  householdNetIncome   Float?         @map("household_net_income")
  incomeProofAvailable Boolean?       @map("income_proof_available")
  schufaAvailable      Boolean?       @map("schufa_available")
  peopleCount          Int?           @map("people_count")
  adultsCount          Int?           @map("adults_count")
  childrenCount        Int?           @map("children_count")
  hasPets              Boolean?       @map("has_pets")
  isSmoker             Boolean?       @map("is_smoker")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  applicant User @relation(fields: [applicantId], references: [id])

  @@map("applicant_profiles")
}

model SavedListing {
  id          String   @id @default(uuid()) @db.Uuid
  applicantId String   @map("applicant_id") @db.Uuid
  listingId   String   @map("listing_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  applicant User    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([applicantId, listingId])
  @@index([applicantId, createdAt])
  @@map("saved_listings")
}

model ListingReport {
  id                  String               @id @default(uuid()) @db.Uuid
  reporterApplicantId String?              @map("reporter_applicant_id") @db.Uuid
  listingId           String               @map("listing_id") @db.Uuid
  reason              ListingReportReason
  detail              String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(3)

  reporter User?   @relation("ListingReportReporter", fields: [reporterApplicantId], references: [id], onDelete: SetNull)
  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@unique([reporterApplicantId, listingId])
  @@index([listingId, createdAt])
  @@map("listing_reports")
}

model UserSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_user_sessions_expire")
  @@map("user_sessions")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  type           String    @db.VarChar(120)
  schemaVersion  Int       @default(1) @map("schema_version")
  applicationId  String?   @map("application_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  deduplicationKey String?  @unique @map("deduplication_key") @db.VarChar(200)
  payload        Json      @db.JsonB
  occurredAt     DateTime  @map("occurred_at") @db.Timestamp(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamp(3)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamp(3)
  attemptCount   Int       @default(0) @map("attempt_count")
  claimToken     String?   @map("claim_token") @db.Uuid
  claimedUntil   DateTime? @map("claimed_until") @db.Timestamp(3)
  lastError      String?   @map("last_error") @db.VarChar(500)

  @@index([nextAttemptAt, createdAt], map: "outbox_events_dispatch_queue_idx")
  @@map("outbox_events")
}

// Immutable result of one application-scoped command, including expiry conflicts.
model ViewingCommandReceipt {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  requestKey String @map("request_key") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  actorSide ViewingParticipantSide @map("actor_side")
  command String @db.VarChar(64)
  requestHash String @map("request_hash") @db.Char(64)
  outcome Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([applicationId, requestKey])
  @@map("viewing_command_receipts")
}
