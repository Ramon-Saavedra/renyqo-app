generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  APPLICANT @map("applicant")
  PROVIDER  @map("provider")
  ADMIN     @map("admin")
}

enum UserStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  DELETED   @map("deleted")
}

enum ListingStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  PAUSED    @map("paused")
  ARCHIVED  @map("archived")
  RENTED    @map("rented")
}

enum ObjectType {
  APARTMENT @map("apartment")
  HOUSE     @map("house")
  ROOM      @map("room")
}

enum PetsPolicy {
  ALLOWED        @map("allowed")
  BY_ARRANGEMENT @map("by_arrangement")
  NOT_ALLOWED    @map("not_allowed")
}

enum SmokingPolicy {
  ALLOWED               @map("allowed")
  BY_ARRANGEMENT        @map("by_arrangement")
  NON_SMOKERS_PREFERRED @map("non_smokers_preferred")
}

enum ApplicationStatus {
  ACTIVE        @map("active")
  WAITING       @map("waiting")
  REJECTED      @map("rejected")
  WITHDRAWN     @map("withdrawn")
  ACCEPTED      @map("accepted")
}

enum ApplicationRejectionReason {
  NOT_SELECTED    @map("not_selected")
  LISTING_RENTED  @map("listing_rented")
}

enum SmokingStatus {
  SMOKER       @map("smoker")
  NON_SMOKER   @map("non_smoker")
  OCCASIONALLY @map("occasionally")
}

enum ProviderType {
  PRIVATE @map("private")
  COMPANY @map("company")
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  name              String
  email             String        @unique
  passwordHash      String        @map("password_hash")
  role              Role          @default(APPLICANT)
  providerType      ProviderType? @map("provider_type")
  companyName       String?       @map("company_name")
  emailVerified     Boolean       @default(false) @map("email_verified")
  status            UserStatus    @default(ACTIVE)
  acceptedTermsAt   DateTime      @map("accepted_terms_at")
  acceptedPrivacyAt DateTime      @map("accepted_privacy_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  listings     Listing[]
  applications Application[]
  profile      ApplicantProfile?
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@map("password_reset_tokens")
}

model Listing {
  id         String        @id @default(uuid()) @db.Uuid
  providerId String        @map("provider_id") @db.Uuid
  status     ListingStatus @default(DRAFT)

  city             String?
  zip              String?
  street           String?
  district         String?
  country          String  @default("DE")
  showExactAddress Boolean @default(false) @map("show_exact_address")

  objectType      ObjectType? @map("object_type")
  livingArea      Float?     @map("living_area")
  rooms           Float?
  bedrooms        Int?
  coldRent        Float?     @map("cold_rent")
  additionalCosts Float?     @map("additional_costs")
  deposit         Float?
  depositMonths   Int        @default(2) @map("deposit_months")
  availableFrom   DateTime?  @map("available_from")

  title            String?
  shortDescription String?  @map("short_description")
  photos           String[]

  minimumHouseholdNetIncome Float?         @map("minimum_household_net_income")
  schufaRequired            Boolean        @default(false) @map("schufa_required")
  incomeProofRequired       Boolean        @default(false) @map("income_proof_required")
  suitableForPeopleCount    Int?           @map("suitable_for_people_count")
  petsPolicy                PetsPolicy?    @map("pets_policy")
  smokingPolicy             SmokingPolicy? @map("smoking_policy")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")
  rentedAt    DateTime? @map("rented_at")

  provider User @relation(fields: [providerId], references: [id])

  applications Application[]
  images       ListingImage[]

  @@index([status, publishedAt, id])
  @@index([status, coldRent, id])
  @@index([status, livingArea, id])
  @@index([status, availableFrom])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  publicId  String   @unique @map("public_id")
  secureUrl String   @map("secure_url")
  position  Int      @default(0)
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@index([listingId])
  @@map("listing_images")
}

model Application {
  id           String             @id @default(uuid()) @db.Uuid
  listingId    String             @map("listing_id") @db.Uuid
  applicantId  String             @map("applicant_id") @db.Uuid
  status       ApplicationStatus  @default(WAITING)
  queueOrder   BigInt             @default(autoincrement()) @map("queue_order")
  rejectedAt   DateTime?          @map("rejected_at")
  publicReason ApplicationRejectionReason? @map("public_reason")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  listing   Listing @relation(fields: [listingId], references: [id])
  applicant User    @relation(fields: [applicantId], references: [id])

  @@index([listingId, status, queueOrder])
  @@index([applicantId])
  @@map("applications")
}

model ApplicantProfile {
  id                   String         @id @default(uuid()) @db.Uuid
  applicantId          String         @unique @map("applicant_id") @db.Uuid
  householdNetIncome   Float?         @map("household_net_income")
  incomeProofAvailable Boolean?       @map("income_proof_available")
  schufaAvailable      Boolean?       @map("schufa_available")
  peopleCount          Int?           @map("people_count")
  adultsCount          Int?           @map("adults_count")
  childrenCount        Int?           @map("children_count")
  hasPets              Boolean?       @map("has_pets")
  petsNote             String?        @map("pets_note")
  smokingStatus        SmokingStatus? @map("smoking_status")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  applicant User @relation(fields: [applicantId], references: [id])

  @@map("applicant_profiles")
}

model UserSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_user_sessions_expire")
  @@map("user_sessions")
}
