generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  APPLICANT @map("applicant")
  PROVIDER  @map("provider")
  ADMIN     @map("admin")
}

enum UserStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  DELETED   @map("deleted")
}

enum ListingStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  PAUSED    @map("paused")
  ARCHIVED  @map("archived")
  RENTED    @map("rented")
}

enum ObjectType {
  APARTMENT @map("apartment")
  HOUSE     @map("house")
  ROOM      @map("room")
}

enum PetsPolicy {
  ALLOWED        @map("allowed")
  BY_ARRANGEMENT @map("by_arrangement")
  NOT_ALLOWED    @map("not_allowed")
}

enum SmokingPolicy {
  ALLOWED        @map("allowed")
  BY_ARRANGEMENT @map("by_arrangement")
  NOT_ALLOWED    @map("not_allowed")
}

enum ApplicationStatus {
  ACTIVE        @map("active")
  WAITING       @map("waiting")
  REJECTED      @map("rejected")
  WITHDRAWN     @map("withdrawn")
  ACCEPTED      @map("accepted")
}

enum ApplicationRejectionReason {
  NOT_SELECTED                @map("not_selected")
  LISTING_RENTED              @map("listing_rented")
  PROFILE_NO_LONGER_ELIGIBLE  @map("profile_no_longer_eligible")
}

enum ListingEventType {
  REJECTED_BY_PROVIDER  @map("rejected_by_provider")
  RESTORED_BY_PROVIDER  @map("restored_by_provider")
}

enum ListingEventSource {
  SYSTEM    @map("system")
  PROVIDER  @map("provider")
  APPLICANT @map("applicant")
}

enum ApplicationActivityType {
  VIEWING_PROPOSED @map("viewing_proposed")
  VIEWING_ACCEPTED @map("viewing_accepted")
  VIEWING_DECLINED @map("viewing_declined")
  VIEWING_CHANGE_REQUESTED @map("viewing_change_requested")
  VIEWING_RESCHEDULED @map("viewing_rescheduled")
  VIEWING_CANCELLED @map("viewing_cancelled")
  VIEWING_COMPLETED @map("viewing_completed")
  VIEWING_NO_SHOW @map("viewing_no_show")
  VIEWING_OUTCOME_CORRECTED @map("viewing_outcome_corrected")
  VIEWING_INTEREST_CONFIRMED @map("viewing_interest_confirmed")
  VIEWING_INTEREST_DECLINED @map("viewing_interest_declined")
  APPLICATION_SUBMITTED          @map("application_submitted")
  APPLICATION_PROMOTED_TO_ACTIVE @map("application_promoted_to_active")
  APPLICATION_WITHDRAWN          @map("application_withdrawn")
  APPLICATION_REJECTED           @map("application_rejected")
  APPLICATION_RESTORED           @map("application_restored")
  APPLICATION_ACCEPTED           @map("application_accepted")
  CONVERSATION_OPENED            @map("conversation_opened")
  MESSAGE_SENT                   @map("message_sent")
  DOCUMENT_REQUESTED             @map("document_requested")
  DOCUMENT_UPLOADED              @map("document_uploaded")
  DOCUMENT_REVIEWED              @map("document_reviewed")
}

enum ApplicationDocumentType {
  SCHUFA              @map("schufa")
  INCOME_PROOF        @map("income_proof")
  IDENTITY_DOCUMENT   @map("identity_document")
  LIABILITY_INSURANCE @map("liability_insurance")
  OTHER               @map("other")
}

enum ApplicationDocumentState {
  PROCESSING @map("processing")
  AVAILABLE  @map("available")
  FAILED     @map("failed")
}

enum ConversationSide {
  PROVIDER  @map("provider")
  APPLICANT @map("applicant")
}

enum ApplicationActivityActorType {
  SYSTEM    @map("system")
  APPLICANT @map("applicant")
  PROVIDER  @map("provider")
}

enum ApplicationActivityVisibility {
  PROVIDER  @map("provider")
  APPLICANT @map("applicant")
  BOTH      @map("both")
  INTERNAL  @map("internal")
}

enum ListingReportReason {
  MISLEADING_INFO       @map("misleading_info")
  SCAM_OR_FRAUD         @map("scam_or_fraud")
  DISCRIMINATION        @map("discrimination")
  INAPPROPRIATE_CONTENT @map("inappropriate_content")
  DUPLICATE_OR_SPAM     @map("duplicate_or_spam")
  OTHER                 @map("other")
}

enum ProviderType {
  PRIVATE @map("private")
  COMPANY @map("company")
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  name              String
  email             String        @unique
  passwordHash      String        @map("password_hash")
  role              Role          @default(APPLICANT)
  providerType      ProviderType? @map("provider_type")
  companyName       String?       @map("company_name")
  emailVerified     Boolean       @default(false) @map("email_verified")
  status            UserStatus    @default(ACTIVE)
  acceptedTermsAt   DateTime      @map("accepted_terms_at")
  acceptedPrivacyAt DateTime      @map("accepted_privacy_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  listings     Listing[]
  applications Application[]
  listingEvents ListingEvent[] @relation("ListingEventActor")
  applicationActivities ApplicationActivity[] @relation("ApplicationActivityActor")
  profile      ApplicantProfile?
  passwordResetTokens PasswordResetToken[]
  savedListings SavedListing[]
  listingReports ListingReport[] @relation("ListingReportReporter")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@map("password_reset_tokens")
}

model Listing {
  id         String        @id @default(uuid()) @db.Uuid
  providerId String        @map("provider_id") @db.Uuid
  status     ListingStatus @default(DRAFT)
  displayOrder Int          @map("display_order")

  city             String?
  zip              String?
  street           String?
  district         String?
  country          String  @default("DE")
  showExactAddress Boolean @default(false) @map("show_exact_address")

  objectType      ObjectType? @map("object_type")
  livingArea      Float?     @map("living_area")
  rooms           Float?
  bedrooms        Int?
  coldRent        Float?     @map("cold_rent")
  additionalCosts Float?     @map("additional_costs")
  deposit         Float?
  depositMonths   Int        @default(2) @map("deposit_months")
  availableFrom   DateTime?  @map("available_from")

  title            String?
  shortDescription String?  @map("short_description")
  photos           String[]

  minimumHouseholdNetIncome Float?         @map("minimum_household_net_income")
  schufaRequired            Boolean        @default(false) @map("schufa_required")
  incomeProofRequired       Boolean        @default(false) @map("income_proof_required")
  suitableForPeopleCount    Int?           @map("suitable_for_people_count")
  petsPolicy                PetsPolicy?    @map("pets_policy")
  smokingPolicy             SmokingPolicy? @map("smoking_policy")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")
  rentedAt    DateTime? @map("rented_at")

  provider User @relation(fields: [providerId], references: [id])

  applications Application[]
  images       ListingImage[]
  listingEvents ListingEvent[]
  savedListings SavedListing[]
  listingReports ListingReport[]

  @@index([status, publishedAt, id])
  @@index([status, coldRent, id])
  @@index([status, livingArea, id])
  @@index([status, availableFrom])
  @@unique([providerId, displayOrder])
  @@index([providerId, displayOrder, id])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  publicId  String   @unique @map("public_id")
  secureUrl String   @map("secure_url")
  position  Int      @default(0)
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@index([listingId])
  @@map("listing_images")
}

model Application {
  id           String             @id @default(uuid()) @db.Uuid
  listingId    String             @map("listing_id") @db.Uuid
  applicantId  String             @map("applicant_id") @db.Uuid
  status       ApplicationStatus  @default(WAITING)
  queueOrder   BigInt             @default(autoincrement()) @map("queue_order")
  rejectedAt   DateTime?                    @map("rejected_at")
  publicReason ApplicationRejectionReason? @map("public_reason")
  activeAt     DateTime?                    @map("active_at")
  withdrawnAt  DateTime?                    @map("withdrawn_at")
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  listing   Listing @relation(fields: [listingId], references: [id])
  applicant User    @relation(fields: [applicantId], references: [id])
  listingEvents ListingEvent[]
  activities ApplicationActivity[]
  conversation ApplicationConversation?
  documentRequests ApplicationDocumentRequest[]
  viewings ApplicationViewing[]

  @@index([listingId, status, queueOrder])
  @@index([applicantId])
  @@map("applications")
}

enum ApplicationViewingStatus {
  PROPOSED @map("proposed")
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
  CHANGE_REQUESTED @map("change_requested")
  CANCELLED @map("cancelled")
  COMPLETED @map("completed")
  NO_SHOW @map("no_show")
  SUPERSEDED @map("superseded")
}

enum ViewingOutcome {
  COMPLETED @map("completed")
  NO_SHOW @map("no_show")
}

enum ViewingInterest {
  STILL_INTERESTED @map("still_interested")
  NOT_INTERESTED @map("not_interested")
}

model ApplicationViewing {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  round Int
  status ApplicationViewingStatus @default(PROPOSED)
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  timeZone String @map("time_zone") @db.VarChar(100)
  providerNote String? @map("provider_note") @db.VarChar(500)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  declinedAt DateTime? @map("declined_at") @db.Timestamptz(3)
  changeRequestedAt DateTime? @map("change_requested_at") @db.Timestamptz(3)
  changeRequestMessage String? @map("change_request_message") @db.VarChar(500)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(3)
  requestKey String @map("request_key") @db.Uuid
  requestHash String @map("request_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  outcomes ApplicationViewingOutcome[]
  interest ApplicationViewingInterest?
  @@unique([applicationId, round])
  @@unique([applicationId, requestKey])
  @@index([applicationId, status, round])
  @@map("application_viewings")
}

model ApplicationViewingOutcome {
  id String @id @default(uuid()) @db.Uuid
  viewingId String @map("viewing_id") @db.Uuid
  revision Int
  outcome ViewingOutcome
  correctionReason String? @map("correction_reason") @db.VarChar(500)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  viewing ApplicationViewing @relation(fields: [viewingId], references: [id], onDelete: Restrict)
  @@unique([viewingId, revision])
  @@map("application_viewing_outcomes")
}

model ApplicationViewingInterest {
  id String @id @default(uuid()) @db.Uuid
  viewingId String @unique @map("viewing_id") @db.Uuid
  interest ViewingInterest
  respondedAt DateTime @default(now()) @map("responded_at") @db.Timestamptz(3)
  viewing ApplicationViewing @relation(fields: [viewingId], references: [id], onDelete: Restrict)
  @@map("application_viewing_interests")
}

model ListingEvent {
  id            String             @id @default(uuid()) @db.Uuid
  listingId     String             @map("listing_id") @db.Uuid
  applicationId String?            @map("application_id") @db.Uuid
  type          ListingEventType
  source        ListingEventSource
  actorUserId   String?            @map("actor_user_id") @db.Uuid
  reason        String?
  payload       Json?
  occurredAt    DateTime           @default(now()) @map("occurred_at")

  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  actor       User?       @relation("ListingEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([listingId, occurredAt])
  @@index([applicationId, occurredAt])
  @@map("listing_events")
}

model ApplicationActivity {
  id          String                         @id @default(uuid()) @db.Uuid
  applicationId String                       @map("application_id") @db.Uuid
  type        ApplicationActivityType
  actorUserId String?                        @map("actor_user_id") @db.Uuid
  actorType   ApplicationActivityActorType   @map("actor_type")
  visibility  ApplicationActivityVisibility
  occurredAt  DateTime                       @default(now()) @map("occurred_at")
  payload     Json?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?        @relation("ApplicationActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, occurredAt, id])
  @@index([applicationId, visibility, occurredAt, id])
  @@map("application_activities")
}

model ApplicationConversation {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @unique @map("application_id") @db.Uuid
  openedAt      DateTime @default(now()) @map("opened_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages ApplicationMessage[]

  @@map("application_conversations")
}

model ApplicationMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  sequence       Int
  senderType     ConversationSide @map("sender_type")
  body           String           @db.VarChar(4000)
  createdAt      DateTime         @default(now()) @map("created_at")
  readAt         DateTime?        @map("read_at")

  conversation ApplicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([conversationId, senderType, readAt])
  @@map("application_messages")
}

model ApplicationDocumentRequest {
  id            String                    @id @default(uuid()) @db.Uuid
  applicationId String                    @map("application_id") @db.Uuid
  type          ApplicationDocumentType
  customLabel   String?                   @map("custom_label") @db.VarChar(100)
  logicalKey    String                    @map("logical_key") @db.VarChar(120)
  round         Int
  requestedAt   DateTime                  @default(now()) @map("requested_at")
  supersededAt  DateTime?                 @map("superseded_at")
  currentFileId String?                   @unique @map("current_file_id") @db.Uuid
  application   Application               @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  files         ApplicationDocumentFile[] @relation("DocumentAttempts")
  currentFile   ApplicationDocumentFile?  @relation("CurrentDocument", fields: [currentFileId], references: [id], onDelete: SetNull)

  @@unique([applicationId, logicalKey, round])
  @@index([applicationId, requestedAt, id])
  @@map("application_document_requests")
}

model ApplicationDocumentFile {
  id            String                      @id @default(uuid()) @db.Uuid
  requestId     String                      @map("request_id") @db.Uuid
  storageKey    String                      @unique @map("storage_key")
  bucket        String
  versionId     String?                     @map("version_id")
  etag          String?
  checksum      String
  mimeType      String                      @map("mime_type")
  size          Int
  state         ApplicationDocumentState    @default(PROCESSING)
  createdAt     DateTime                    @default(now()) @map("created_at")
  recoverAfter  DateTime                    @map("recover_after")
  expiresAt     DateTime                    @map("expires_at")
  availableAt   DateTime?                   @map("available_at")
  reviewedAt    DateTime?                   @map("reviewed_at")
  scanVerdict   String?                     @map("scan_verdict")
  failureReason String?                     @map("failure_reason")
  request       ApplicationDocumentRequest  @relation("DocumentAttempts", fields: [requestId], references: [id], onDelete: Restrict)
  currentFor    ApplicationDocumentRequest? @relation("CurrentDocument")

  @@index([state, recoverAfter, id])
  @@index([requestId, createdAt, id])
  @@map("application_document_files")
}

model ApplicantProfile {
  id                   String         @id @default(uuid()) @db.Uuid
  applicantId          String         @unique @map("applicant_id") @db.Uuid
  introduction         String?
  householdNetIncome   Float?         @map("household_net_income")
  incomeProofAvailable Boolean?       @map("income_proof_available")
  schufaAvailable      Boolean?       @map("schufa_available")
  peopleCount          Int?           @map("people_count")
  adultsCount          Int?           @map("adults_count")
  childrenCount        Int?           @map("children_count")
  hasPets              Boolean?       @map("has_pets")
  isSmoker             Boolean?       @map("is_smoker")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  applicant User @relation(fields: [applicantId], references: [id])

  @@map("applicant_profiles")
}

model SavedListing {
  id          String   @id @default(uuid()) @db.Uuid
  applicantId String   @map("applicant_id") @db.Uuid
  listingId   String   @map("listing_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  applicant User    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([applicantId, listingId])
  @@index([applicantId, createdAt])
  @@map("saved_listings")
}

model ListingReport {
  id                  String               @id @default(uuid()) @db.Uuid
  reporterApplicantId String?              @map("reporter_applicant_id") @db.Uuid
  listingId           String               @map("listing_id") @db.Uuid
  reason              ListingReportReason
  detail              String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(3)

  reporter User?   @relation("ListingReportReporter", fields: [reporterApplicantId], references: [id], onDelete: SetNull)
  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@unique([reporterApplicantId, listingId])
  @@index([listingId, createdAt])
  @@map("listing_reports")
}

model UserSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_user_sessions_expire")
  @@map("user_sessions")
}
