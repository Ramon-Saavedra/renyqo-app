PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://renyqo:renyqo_dev@localhost:5433/renyqo_dev
E2E_DATABASE_URL=postgresql://renyqo:renyqo_dev@localhost:5434/renyqo_e2e?schema=public
E2E_DATABASE_ALLOW_RESET=true
SESSION_SECRET=
FRONTEND_URL=http://localhost:3001
AWS_REGION=eu-central-1
DOCUMENTS_S3_BUCKET=
DOCUMENTS_AWS_ACCOUNT_ID=
DOCUMENTS_GUARDDUTY_PLAN_ARN=
DOCUMENTS_SCAN_QUEUE_URL=
SES_FROM_EMAIL=no-reply@example.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=renyqo
OPENAI_API_KEY=
OPENAI_LISTING_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
AI_RATE_LIMIT_WINDOW_MS=60000
AI_TEXT_RATE_LIMIT=10
AI_PDF_RATE_LIMIT=3
AI_AUDIO_RATE_LIMIT=3
# Outbox: events are always written with mutations; dispatch stays off until realtime transport exists.
OUTBOX_DISPATCH_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=25
OUTBOX_RETENTION_DAYS=7
OUTBOX_RETENTION_BATCH_SIZE=500

# Single-instance realtime invalidations. Dispatch also requires REALTIME_ENABLED=true.
REALTIME_ENABLED=false
REALTIME_SESSION_RECHECK_INTERVAL_MS=15000
REALTIME_MAX_CONNECTIONS_PER_SESSION=5
REALTIME_MAX_CONNECTIONS=1000
REALTIME_HANDSHAKES_PER_IP_PER_MINUTE=60

# Viewing deadlines: enabled by default outside tests; scans overdue durable rows.
VIEWING_EXPIRY_ENABLED=true
VIEWING_EXPIRY_INTERVAL_MS=30000
VIEWING_EXPIRY_BATCH_SIZE=50
